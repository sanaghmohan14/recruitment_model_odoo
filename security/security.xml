<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_manpower" model="ir.module.category">
        <field name="name">Manpower Requisition</field>
        <field name="sequence">40</field>
    </record>

    <record id="privilege_manpower" model="res.groups.privilege">
        <field name="name">Manpower Requisition</field>
        <field name="category_id" ref="module_category_manpower"/>
    </record>

    <record id="group_dept_head" model="res.groups">
        <field name="name">Department Head</field>
        <field name="privilege_id" ref="privilege_manpower"/>
    </record>

    <record id="group_hr" model="res.groups">
        <field name="name">HR</field>
        <field name="privilege_id" ref="privilege_manpower"/>
    </record>

    <record id="group_ceo" model="res.groups">
        <field name="name">CEO</field>
        <field name="privilege_id" ref="privilege_manpower"/>
    </record>

    <!-- Record rules -->
    <record id="rule_requirement_dept_head" model="ir.rule">
        <field name="name">Requirement: Department Head sees own</field>
        <field name="model_id" ref="model_manpower_requirement"/>
        <field name="groups" eval="[(4, ref('group_dept_head'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_requirement_hr" model="ir.rule">
        <field name="name">Requirement: HR sees all</field>
        <field name="model_id" ref="model_manpower_requirement"/>
        <field name="groups" eval="[(4, ref('group_hr'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_requirement_ceo" model="ir.rule">
        <field name="name">Requirement: CEO sees all</field>
        <field name="model_id" ref="model_manpower_requirement"/>
        <field name="groups" eval="[(4, ref('group_ceo'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
