<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_manpower" model="ir.module.category">
        <field name="name">Manpower Requisition</field>
        <field name="sequence">40</field>
    </record>

    <record id="privilege_manpower" model="res.groups.privilege">
        <field name="name">Manpower Requisition</field>
        <field name="category_id" ref="module_category_manpower"/>
    </record>

    <record id="group_dept_head" model="res.groups">
        <field name="name">Consultant</field>
        <field name="privilege_id" ref="privilege_manpower"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="privilege_id" ref="privilege_manpower"/>
        <field name="implied_ids" eval="[(4, ref('group_dept_head')), (4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="group_hr" model="res.groups">
        <field name="name">HR</field>
        <field name="privilege_id" ref="privilege_manpower"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_ceo" model="res.groups">
        <field name="name">CEO</field>
        <field name="privilege_id" ref="privilege_manpower"/>
    </record>

    <!-- Record rules for Manpower Requirement -->
    <record id="rule_requirement_dept_head" model="ir.rule">
        <field name="name">Requirement: Consultant sees none</field>
        <field name="model_id" ref="model_manpower_requirement"/>
        <field name="groups" eval="[(4, ref('group_dept_head'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>

    <record id="rule_requirement_project_manager" model="ir.rule">
        <field name="name">Requirement: Project Manager sees all</field>
        <field name="model_id" ref="model_manpower_requirement"/>
        <field name="groups" eval="[(4, ref('group_project_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_requirement_hr" model="ir.rule">
        <field name="name">Requirement: HR sees approved requirements</field>
        <field name="model_id" ref="model_manpower_requirement"/>
        <field name="groups" eval="[(4, ref('group_hr'))]"/>
        <field name="domain_force">[('state', 'in', ('approved', 'rejected'))]</field>
    </record>

    <record id="rule_requirement_ceo" model="ir.rule">
        <field name="name">Requirement: CEO sees all</field>
        <field name="model_id" ref="model_manpower_requirement"/>
        <field name="groups" eval="[(4, ref('group_ceo'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Global record rules: Project Users / HR only see assigned projects & tasks -->
    <record id="rule_project_task_hr_assigned_only" model="ir.rule">
        <field name="name">Task: Only see assigned tasks</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [(1, '=', 1)] if (user.has_group('project.group_project_manager') or user.has_group('base.group_system')) else ['|', ('user_ids', 'in', [user.id]), ('create_uid', '=', user.id)]
        </field>
    </record>

    <record id="rule_project_project_hr_assigned_only" model="ir.rule">
        <field name="name">Project: Only see assigned projects</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [(1, '=', 1)] if (user.has_group('project.group_project_manager') or user.has_group('base.group_system')) else ['|', '|', ('task_user_ids', 'in', [user.id]), ('user_id', '=', user.id), ('create_uid', '=', user.id)]
        </field>
    </record>
</odoo>
