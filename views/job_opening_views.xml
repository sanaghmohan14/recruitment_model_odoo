<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manpower_job_opening_form" model="ir.ui.view">
        <field name="name">manpower.job.opening.form</field>
        <field name="model">manpower.job.opening</field>
        <field name="arch" type="xml">
            <form string="Job Opening">
                <header>
                    <button name="action_publish" string="Publish" type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="manpower_requisition.group_hr"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'published'"
                            groups="manpower_requisition.group_hr"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'published')"
                            groups="manpower_requisition.group_hr"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('closed', 'cancelled')"
                            groups="manpower_requisition.group_hr"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_applications" type="object" class="oe_stat_button"
                                icon="fa-users">
                            <field name="application_count" widget="statinfo" string="Applications"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requirement_id" readonly="state != 'draft'"/>
                            <field name="title" readonly="state != 'draft'"/>
                            <field name="client_id"/>
                            <field name="vacancies" readonly="state != 'draft'"/>
                            <field name="location" readonly="state != 'draft'"/>
                            <field name="qualification" readonly="state != 'draft'"/>
                            <field name="skill_ids" widget="many2many_tags"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <label for="experience_min" string="Experience (yrs)"/>
                            <div class="o_row">
                                <field name="experience_min" readonly="state != 'draft'"/> -
                                <field name="experience_max" readonly="state != 'draft'"/>
                            </div>
                            <field name="currency_id" invisible="1"/>
                            <label for="salary_min" string="Salary Range"/>
                            <div class="o_row">
                                <field name="salary_min" readonly="state != 'draft'"/> -
                                <field name="salary_max" readonly="state != 'draft'"/>
                            </div>
                            <field name="channel_ids" widget="many2many_tags"
                                   readonly="state not in ('draft', 'published')"/>
                            <field name="posting_date"/>
                            <field name="closing_date" readonly="state in ('closed', 'cancelled')"/>
                            <field name="published_by_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Job Description" name="jd">
                            <field name="jd_approved"/>
                            <field name="description" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manpower_job_opening_list" model="ir.ui.view">
        <field name="name">manpower.job.opening.list</field>
        <field name="model">manpower.job.opening</field>
        <field name="arch" type="xml">
            <list string="Job Openings" decoration-success="state == 'published'"
                  decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="title" string="Position Name"/>
                <field name="client_id" optional="show"/>
                <field name="department_id"/>
                <field name="vacancies" string="To Recruit"/>
                <field name="new_application_count" string="New Applications"/>
                <field name="in_progress_application_count" string="In Progress"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="location" optional="show"/>
                <field name="posting_date"/>
                <field name="closing_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-danger="state == 'cancelled'"
                       decoration-warning="state == 'closed'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_manpower_application_job_position_list" model="ir.ui.view">
        <field name="name">manpower.application.job.position.list</field>
        <field name="model">manpower.job.opening</field>
        <field name="arch" type="xml">
            <list string="Applications by Job Position"
                  decoration-success="state == 'published'"
                  decoration-muted="state in ('closed', 'cancelled')">
                <field name="title" string="Position Name"/>
                <field name="client_id" optional="show"/>
                <field name="vacancies" string="To Recruit"/>
                <field name="new_application_count" string="New Applications"/>
                <field name="in_progress_application_count" string="In Progress"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="location" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-danger="state == 'cancelled'"
                       decoration-warning="state == 'closed'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_manpower_job_opening_search" model="ir.ui.view">
        <field name="name">manpower.job.opening.search</field>
        <field name="model">manpower.job.opening</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="client_id"/>
                <field name="department_id"/>
                <filter name="f_published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="f_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="f_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <group>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="g_dept" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_manpower_job_opening" model="ir.actions.act_window">
        <field name="name">Job Openings</field>
        <field name="res_model">manpower.job.opening</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No job openings yet</p>
            <p>Open an approved requirement and click "Create Job Opening".</p>
        </field>
    </record>

    <record id="action_manpower_application_by_position" model="ir.actions.act_window">
        <field name="name">Applications by Job Position</field>
        <field name="res_model">manpower.job.opening</field>
        <field name="view_id" ref="view_manpower_application_job_position_list"/>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'cancelled')]</field>
    </record>

    <record id="view_manpower_posting_channel_list" model="ir.ui.view">
        <field name="name">manpower.posting.channel.list</field>
        <field name="model">manpower.posting.channel</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_manpower_posting_channel" model="ir.actions.act_window">
        <field name="name">Posting Channels</field>
        <field name="res_model">manpower.posting.channel</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_manpower_skill_list" model="ir.ui.view">
        <field name="name">manpower.skill.list</field>
        <field name="model">manpower.skill</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_manpower_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">manpower.skill</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
