<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="manpower_job_opening_list" name="Manpower Job Openings">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 class="mb-0">Open Positions</h1>
                        <a href="/manpower/requirement" class="btn btn-outline-primary">
                            Submit Manpower Requirement
                        </a>
                    </div>

                    <div class="row mt-4">
                        <t t-foreach="jobs" t-as="job">
                            <div class="col-lg-6 mb-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <h3><a t-att-href="job._get_website_url()"><t t-esc="job.title"/></a></h3>

                                        <!-- Location -->
                                        <p t-if="job.location" class="mb-1">
                                            <i class="fa fa-map-marker me-2 text-primary"/>
                                            <t t-esc="job.location"/>
                                        </p>

                                        <!-- Vacancies -->
                                        <p t-if="job.vacancies" class="mb-1">
                                            <i class="fa fa-users me-2 text-primary"/>
                                            <strong>Openings:</strong> <t t-esc="job.vacancies"/>
                                        </p>

                                        <!-- Experience Range -->
                                        <p t-if="job.experience_min or job.experience_max" class="mb-1">
                                            <i class="fa fa-briefcase me-2 text-primary"/>
                                            <strong>Experience:</strong>
                                            <t t-if="job.experience_min and job.experience_max">
                                                <t t-esc="job.experience_min"/> - <t t-esc="job.experience_max"/> yrs
                                            </t>
                                            <t t-elif="job.experience_min">
                                                Min <t t-esc="job.experience_min"/> yrs
                                            </t>
                                            <t t-elif="job.experience_max">
                                                Up to <t t-esc="job.experience_max"/> yrs
                                            </t>
                                        </p>

                                        <!-- Salary Range -->
                                        <p t-if="job.salary_min or job.salary_max" class="mb-1">
                                            <i class="fa fa-money me-2 text-primary"/>
                                            <strong>Salary:</strong>
                                            <t t-if="job.salary_min and job.salary_max">
                                                <t t-esc="job.currency_id.symbol"/><t t-esc="'{:,.0f}'.format(job.salary_min)"/>
                                                - <t t-esc="job.currency_id.symbol"/><t t-esc="'{:,.0f}'.format(job.salary_max)"/>
                                            </t>
                                            <t t-elif="job.salary_min">
                                                From <t t-esc="job.currency_id.symbol"/><t t-esc="'{:,.0f}'.format(job.salary_min)"/>
                                            </t>
                                            <t t-elif="job.salary_max">
                                                Up to <t t-esc="job.currency_id.symbol"/><t t-esc="'{:,.0f}'.format(job.salary_max)"/>
                                            </t>
                                        </p>

                                        <!-- Skills -->
                                        <div t-if="job.skill_ids" class="mb-2">
                                            <i class="fa fa-cogs me-2 text-primary"/>
                                            <strong>Skills:</strong>
                                            <t t-foreach="job.skill_ids" t-as="skill">
                                                <span class="badge bg-info text-dark ms-1"><t t-esc="skill.name"/></span>
                                            </t>
                                        </div>

                                        <!-- Closing Date -->
                                        <p t-if="job.closing_date" class="mb-2">
                                            <i class="fa fa-calendar-times-o me-2 text-danger"/>
                                            <strong>Apply Before:</strong>
                                            <t t-esc="job.closing_date" t-options="{'widget': 'date'}"/>
                                        </p>

                                        <a class="btn btn-primary mt-2" t-att-href="job._get_website_url()">View Job &amp; Apply</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <p t-if="not jobs">There are no open positions at the moment.</p>
                </section>
            </div>
        </t>
    </template>

    <template id="manpower_job_opening_detail" name="Manpower Job Opening Detail">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5">
                    <div class="row">
                        <!-- Left Column: Job Details -->
                        <div class="col-lg-5 mb-4">
                            <h1 class="h2 mb-3" t-esc="job.title"/>

                            <!-- Key Details Summary -->
                            <div class="card bg-light mb-4 shadow-sm border-0">
                                <div class="card-body">
                                    <div class="row">
                                        <!-- Location -->
                                        <div t-if="job.location" class="col-sm-6 mb-2">
                                            <i class="fa fa-map-marker me-2 text-primary"/>
                                            <strong>Location:</strong><br/>
                                            <span t-esc="job.location"/>
                                        </div>

                                        <!-- Vacancies -->
                                        <div t-if="job.vacancies" class="col-sm-6 mb-2">
                                            <i class="fa fa-users me-2 text-primary"/>
                                            <strong>Openings:</strong><br/>
                                            <span t-esc="job.vacancies"/>
                                        </div>

                                        <!-- Experience Range -->
                                        <div t-if="job.experience_min or job.experience_max" class="col-sm-6 mb-2">
                                            <i class="fa fa-briefcase me-2 text-primary"/>
                                            <strong>Experience:</strong><br/>
                                            <t t-if="job.experience_min and job.experience_max">
                                                <span><t t-esc="job.experience_min"/> - <t t-esc="job.experience_max"/> years</span>
                                            </t>
                                            <t t-elif="job.experience_min">
                                                <span>Minimum <t t-esc="job.experience_min"/> years</span>
                                            </t>
                                            <t t-elif="job.experience_max">
                                                <span>Up to <t t-esc="job.experience_max"/> years</span>
                                            </t>
                                        </div>

                                        <!-- Salary Range -->
                                        <div t-if="job.salary_min or job.salary_max" class="col-sm-6 mb-2">
                                            <i class="fa fa-money me-2 text-primary"/>
                                            <strong>Salary Range:</strong><br/>
                                            <t t-if="job.salary_min and job.salary_max">
                                                <span>
                                                    <t t-esc="job.currency_id.symbol"/><t t-esc="'{:,.0f}'.format(job.salary_min)"/>
                                                    - <t t-esc="job.currency_id.symbol"/><t t-esc="'{:,.0f}'.format(job.salary_max)"/>
                                                </span>
                                            </t>
                                            <t t-elif="job.salary_min">
                                                <span>From <t t-esc="job.currency_id.symbol"/><t t-esc="'{:,.0f}'.format(job.salary_min)"/></span>
                                            </t>
                                            <t t-elif="job.salary_max">
                                                <span>Up to <t t-esc="job.currency_id.symbol"/><t t-esc="'{:,.0f}'.format(job.salary_max)"/></span>
                                            </t>
                                        </div>

                                        <!-- Qualification -->
                                        <div t-if="job.qualification" class="col-sm-6 mb-2">
                                            <i class="fa fa-graduation-cap me-2 text-primary"/>
                                            <strong>Qualification:</strong><br/>
                                            <span t-esc="job.qualification"/>
                                        </div>

                                        <!-- Application Closing Date -->
                                        <div t-if="job.closing_date" class="col-sm-6 mb-2">
                                            <i class="fa fa-calendar-times-o me-2 text-danger"/>
                                            <strong>Apply Before:</strong><br/>
                                            <span t-esc="job.closing_date" t-options="{'widget': 'date'}"/>
                                        </div>

                                        <!-- Posting Date -->
                                        <div t-if="job.posting_date" class="col-sm-6 mb-2">
                                            <i class="fa fa-calendar me-2 text-primary"/>
                                            <strong>Posted On:</strong><br/>
                                            <span t-esc="job.posting_date" t-options="{'widget': 'date'}"/>
                                        </div>

                                        <!-- Department -->
                                        <div t-if="job.department_id" class="col-sm-6 mb-2">
                                            <i class="fa fa-building me-2 text-primary"/>
                                            <strong>Department:</strong><br/>
                                            <span t-esc="job.department_id.name"/>
                                        </div>
                                    </div>

                                    <!-- Skills -->
                                    <div t-if="job.skill_ids" class="mt-2 pt-2 border-top">
                                        <i class="fa fa-cogs me-2 text-primary"/>
                                        <strong>Skills Required:</strong>
                                        <div class="mt-1">
                                            <t t-foreach="job.skill_ids" t-as="skill">
                                                <span class="badge bg-info text-dark me-1 mb-1"><t t-esc="skill.name"/></span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Job Description -->
                            <h4 class="mb-3">Job Description</h4>
                            <div class="card p-3 shadow-sm border-0 mb-4" t-field="job.description"/>

                            <!-- Client Hiring Link -->
                            <div class="mb-4">
                                <a t-attf-href="/manpower/requirement?job_role=#{job.title}" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa fa-building-o me-1"/> Need to hire for this position? Submit a Client Requirement
                                </a>
                            </div>
                        </div>

                        <!-- Right Column: Comprehensive Application Form -->
                        <div class="col-lg-7">
                            <div class="card shadow-sm border-0">
                                <div class="card-body p-4">
                                    <h3 class="mb-3">Apply for this Position</h3>

                                    <!-- Closing date notice -->
                                    <div t-if="job.closing_date and not job.is_expired" class="alert alert-info py-2 mb-3">
                                        <i class="fa fa-clock-o me-1"/>
                                        Applications close on <strong t-esc="job.closing_date" t-options="{'widget': 'date'}"/>
                                    </div>

                                    <div t-if="job.is_expired" class="alert alert-warning py-2 mb-3">
                                        <i class="fa fa-exclamation-triangle me-1"/>
                                        This job opening has expired and is no longer accepting applications.
                                    </div>

                                    <p class="alert alert-danger py-2" t-if="error" t-esc="error"/>

                                    <form t-if="not job.is_expired" t-att-action="job._get_website_url() + '/apply'" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <!-- 1. Personal Details -->
                                        <h5 class="text-primary border-bottom pb-2 mb-3">
                                            <i class="fa fa-user me-2"/>Personal Details
                                        </h5>
                                        <div class="row g-3 mb-3">
                                            <div class="col-12">
                                                <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                                                <input name="applicant_name" required="required" class="form-control"
                                                       placeholder="e.g. John Doe"
                                                       t-att-value="post.get('applicant_name') if post else ''"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                                                <input name="email" type="email" required="required" class="form-control"
                                                       placeholder="e.g. john.doe@example.com"
                                                       t-att-value="post.get('email') if post else ''"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                                                <input name="mobile" type="tel" required="required" class="form-control"
                                                       placeholder="e.g. +91 9876543210"
                                                       t-att-value="post.get('mobile') if post else ''"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Alternate Phone</label>
                                                <input name="phone" type="tel" class="form-control"
                                                       placeholder="e.g. +91 9876543211"
                                                       t-att-value="post.get('phone') if post else ''"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Date of Birth</label>
                                                <input name="date_of_birth" type="date" class="form-control"
                                                       t-att-value="post.get('date_of_birth') if post else ''"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Gender</label>
                                                <select name="gender" class="form-select">
                                                    <option value="">Select Gender</option>
                                                    <option value="male" t-att-selected="'selected' if post and post.get('gender') == 'male' else None">Male</option>
                                                    <option value="female" t-att-selected="'selected' if post and post.get('gender') == 'female' else None">Female</option>
                                                    <option value="other" t-att-selected="'selected' if post and post.get('gender') == 'other' else None">Other</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">City / Location</label>
                                                <input name="address" class="form-control"
                                                       placeholder="e.g. Mumbai, Maharashtra"
                                                       t-att-value="post.get('address') if post else ''"/>
                                            </div>
                                        </div>

                                        <!-- 2. Academic / Education Details -->
                                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-4">
                                            <i class="fa fa-graduation-cap me-2"/>Academic &amp; Education Details
                                        </h5>
                                        <div class="row g-3 mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Highest Qualification</label>
                                                <input name="highest_qualification" class="form-control"
                                                       placeholder="e.g. B.Tech / BCA / MCA / MBA"
                                                       t-att-value="post.get('highest_qualification') if post else ''"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Specialization</label>
                                                <input name="specialization" class="form-control"
                                                       placeholder="e.g. Computer Science / Information Tech"
                                                       t-att-value="post.get('specialization') if post else ''"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Institution / University</label>
                                                <input name="institution" class="form-control"
                                                       placeholder="e.g. University / College name"
                                                       t-att-value="post.get('institution') if post else ''"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Graduation Year</label>
                                                <input name="graduation_year" class="form-control"
                                                       placeholder="e.g. 2022"
                                                       t-att-value="post.get('graduation_year') if post else ''"/>
                                            </div>
                                        </div>

                                        <!-- 3. Professional Experience -->
                                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-4">
                                            <i class="fa fa-briefcase me-2"/>Professional Experience
                                        </h5>
                                        <div class="row g-3 mb-3">
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold">Total Experience (Years)</label>
                                                <input name="total_experience" type="number" step="0.5" min="0" class="form-control"
                                                       placeholder="e.g. 3.5"
                                                       t-att-value="post.get('total_experience') if post else ''"/>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold">Current Employer</label>
                                                <input name="current_employer" class="form-control"
                                                       placeholder="e.g. ABC Technologies"
                                                       t-att-value="post.get('current_employer') if post else ''"/>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold">Current Designation</label>
                                                <input name="current_designation" class="form-control"
                                                       placeholder="e.g. Software Engineer"
                                                       t-att-value="post.get('current_designation') if post else ''"/>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label fw-semibold">Experience Details / Summary</label>
                                                <textarea name="experience_details" class="form-control" rows="3"
                                                          placeholder="Key responsibilities, projects, and technologies worked on..."><t t-if="post and post.get('experience_details')" t-esc="post.get('experience_details')"/></textarea>
                                            </div>
                                        </div>

                                        <!-- 4. Compensation & Availability -->
                                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-4">
                                            <i class="fa fa-money me-2"/>Salary &amp; Notice Period
                                        </h5>
                                        <div class="row g-3 mb-4">
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold">Current Salary (<t t-esc="job.currency_id.symbol"/>)</label>
                                                <input name="current_salary" type="number" step="any" min="0" class="form-control"
                                                       placeholder="Annual CTC"
                                                       t-att-value="post.get('current_salary') if post else ''"/>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold">Expected Salary (<t t-esc="job.currency_id.symbol"/>)</label>
                                                <input name="expected_salary" type="number" step="any" min="0" class="form-control"
                                                       placeholder="Expected CTC"
                                                       t-att-value="post.get('expected_salary') if post else ''"/>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label fw-semibold">Notice Period</label>
                                                <input name="notice_period" class="form-control"
                                                       placeholder="e.g. Immediate / 30 Days"
                                                       t-att-value="post.get('notice_period') if post else ''"/>
                                            </div>
                                        </div>

                                        <button type="submit" class="btn btn-primary btn-lg w-100">
                                            <i class="fa fa-paper-plane me-2"/>Submit Application
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="manpower_job_application_thanks" name="Manpower Job Application Thanks">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="container py-5 text-center">
                    <h1>Thank you for applying</h1>
                    <p>Your application for <strong t-esc="job.title"/> has been received.</p>
                </section>
            </div>
        </t>
    </template>
</odoo>

