<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manpower_requirement_form" model="ir.ui.view">
        <field name="name">manpower.requirement.form</field>
        <field name="model">manpower.requirement</field>
        <field name="arch" type="xml">
            <form string="Manpower Requirement">
                <header>
                    <field name="is_ceo" invisible="1"/>
                    <field name="is_hr" invisible="1"/>
                    <field name="is_pm" invisible="1"/>
                    <button name="action_send_for_approval" string="Send to CEO" type="object" class="btn-primary"
                            invisible="state not in ('draft', 'pm_review')"
                            groups="manpower_requisition.group_project_manager"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'pending_approval'"
                            groups="manpower_requisition.group_ceo"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('draft', 'pm_review', 'pending_approval')"
                            groups="manpower_requisition.group_project_manager,manpower_requisition.group_ceo"/>
                    <button name="action_create_opening" string="Create Job Opening" type="object" class="btn-primary"
                            invisible="state != 'approved' or not is_hr"
                            groups="manpower_requisition.group_hr"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('pm_review', 'rejected')"
                            groups="manpower_requisition.group_project_manager"/>
                    <button name="action_open_client_update_wizard" string="Send Update to Client" type="object" class="btn-secondary"
                            invisible="state not in ('draft', 'pm_review', 'pending_approval', 'approved')"
                            groups="manpower_requisition.group_project_manager,manpower_requisition.group_hr,manpower_requisition.group_ceo"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_openings" type="object" class="oe_stat_button"
                                icon="fa-briefcase" invisible="opening_count == 0">
                            <field name="opening_count" widget="statinfo" string="Job Openings"/>
                        </button>
                        <button name="action_view_applications" type="object" class="oe_stat_button"
                                icon="fa-users" invisible="application_count == 0">
                            <field name="application_count" widget="statinfo" string="Applications"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Requisition Number"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Client Details">
                            <field name="client_id" string="Client" readonly="state not in ('draft', 'pm_review', 'hr_review')"
                                   placeholder="Select Client..."/>
                            <field name="client_email" widget="email" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                            <field name="client_phone" widget="phone" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                            <field name="client_address" readonly="state not in ('draft', 'pm_review', 'hr_review')"
                                   placeholder="Client Address..."/>
                            <field name="client_company_name" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                            <field name="client_contact_name" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                        </group>
                        <group string="Request Details">
                            <field name="project_id" invisible="1"/>
                            <field name="task_id" readonly="state not in ('draft', 'pm_review', 'hr_review')"
                                   domain="[('project_id', '=', project_id)] if project_id else []"/>
                            <field name="request_type"/>
                            <field name="requested_by_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requirement" name="requirement">
                            <group>
                                <group string="Position">
                                    <field name="job_title" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                    <field name="vacancies" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                    <field name="qualification" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                    <field name="skill_ids" widget="many2many_tags"
                                           readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                    <field name="location" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                    <field name="closing_date" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                </group>
                                <group string="Joining">
                                    <field name="joining_requirement" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                    <field name="joining_date" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                    <field name="reason" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                    <field name="reason_note" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                </group>
                            </group>
                            <group string="Job Description &amp; Scope">
                                <field name="job_description" placeholder="Client requirement details, scope of work, key responsibilities..."
                                       readonly="state not in ('draft', 'pm_review', 'hr_review')" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Review &amp; Budget" name="review_budget">
                            <group>
                                <group string="Experience">
                                    <field name="experience_min" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                    <field name="experience_max" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                </group>
                                <group string="Salary">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="salary_min" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                    <field name="salary_max" readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                </group>
                            </group>
                            <group string="Notes">
                                <field name="pm_notes" placeholder="Project Manager notes..." readonly="state not in ('draft', 'pm_review', 'hr_review')"/>
                                <field name="hr_notes" placeholder="HR notes..." readonly="state not in ('draft', 'pm_review', 'hr_review', 'approved')"/>
                            </group>
                        </page>
                        <page string="Approval" name="approval">
                            <group>
                                <group>
                                    <field name="submitted_date"/>
                                    <field name="pm_reviewed_by_id"/>
                                    <field name="approved_by_id"/>
                                    <field name="approved_date"/>
                                    <field name="hr_reviewed_by_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manpower_requirement_list" model="ir.ui.view">
        <field name="name">manpower.requirement.list</field>
        <field name="model">manpower.requirement</field>
        <field name="arch" type="xml">
            <list string="Manpower Requirements"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-info="state == 'pending_approval'">
                <field name="name"/>
                <field name="request_type" optional="show"/>
                <field name="project_id" optional="hide"/>
                <field name="task_id" optional="show"/>
                <field name="client_id" optional="show"/>
                <field name="client_company_name" string="Company" optional="show"/>
                <field name="job_title"/>
                <field name="vacancies"/>
                <field name="location" optional="show"/>
                <field name="closing_date" optional="show"/>
                <field name="requested_by_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state in ('pm_review', 'hr_review')"
                       decoration-info="state == 'pending_approval'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_manpower_requirement_search" model="ir.ui.view">
        <field name="name">manpower.requirement.search</field>
        <field name="model">manpower.requirement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="job_title"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="client_id"/>
                <field name="client_company_name"/>
                <field name="client_contact_name"/>
                <field name="client_email"/>
                <field name="client_address"/>
                <filter name="f_draft" string="Draft" domain="[('state', 'in', ('draft', 'pm_review'))]"/>
                <filter name="f_pending" string="Pending Approval" domain="[('state', '=', 'pending_approval')]"/>
                <filter name="f_approved" string="Approved (Goes to HR)" domain="[('state', '=', 'approved')]"/>
                <filter name="f_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="g_client" string="Client" context="{'group_by': 'client_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_manpower_requirement" model="ir.actions.act_window">
        <field name="name">Manpower Requirements</field>
        <field name="res_model">manpower.requirement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new manpower requirement</p>
            <p>Project Managers create requirements from job role tasks and submit to CEO for approval.</p>
        </field>
    </record>

    <record id="view_manpower_application_requirement_list" model="ir.ui.view">
        <field name="name">manpower.application.requirement.list</field>
        <field name="model">manpower.requirement</field>
        <field name="arch" type="xml">
            <list string="Applications by Requirement"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'rejected'">
                <field name="name" string="Requisition Ref"/>
                <field name="job_title" string="Position"/>
                <field name="client_company_name" string="Company" optional="show"/>
                <field name="client_id" optional="show"/>
                <field name="vacancies" string="Vacancies"/>
                <field name="application_count" string="Applications"/>
                <field name="new_application_count" string="New"/>
                <field name="in_progress_application_count" string="In Progress"/>
                <field name="location" optional="show"/>
                <field name="closing_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state in ('pm_review', 'hr_review')"
                       decoration-info="state == 'pending_approval'"
                       decoration-muted="state == 'draft'"/>
                <button name="action_view_applications" type="object" string="View Applications"
                        icon="fa-users" class="btn-primary btn-sm"/>
            </list>
        </field>
    </record>

    <record id="action_manpower_application_by_requirement" model="ir.actions.act_window">
        <field name="name">Applications by Requirement</field>
        <field name="res_model">manpower.requirement</field>
        <field name="view_id" ref="view_manpower_application_requirement_list"/>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No requirements found</p>
            <p>Candidate applications linked to client requirements will be listed here.</p>
        </field>
    </record>
</odoo>
