<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manpower_requirement_client_wizard_form" model="ir.ui.view">
        <field name="name">manpower.requirement.client.wizard.form</field>
        <field name="model">manpower.requirement.client.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Requirement Update to Client">
                <sheet>
                    <group>
                        <group>
                            <field name="requirement_id"/>
                            <field name="client_id"/>
                        </group>
                        <group>
                            <field name="stage_label"/>
                            <field name="email_to" widget="email"/>
                        </group>
                    </group>
                    <group>
                        <field name="subject"/>
                    </group>
                    <label for="body" string="Email Body"/>
                    <field name="body" widget="html" options="{'style-inline': true}"/>
                </sheet>
                <footer>
                    <button name="action_send_email" string="Send Email to Client" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
