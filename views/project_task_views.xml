<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task form: Create Hiring Request button in header & stat button (shown when project has hiring enabled) -->
    <record id="view_task_form_inherit_manpower" model="ir.ui.view">
        <field name="name">project.task.form.inherit.manpower</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="hiring_required" invisible="1"/>
                <field name="project_hiring_required" invisible="1"/>
                <button name="action_create_hiring_request" string="Create Hiring Request"
                        type="object" class="btn-primary"
                        invisible="not hiring_required and not project_hiring_required"
                        groups="manpower_requisition.group_project_manager"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_hiring_requests" type="object" class="oe_stat_button"
                        icon="fa-users" invisible="not hiring_required and not project_hiring_required and requirement_count == 0"
                        groups="manpower_requisition.group_project_manager,manpower_requisition.group_hr,manpower_requisition.group_ceo">
                    <field name="requirement_count" widget="statinfo" string="Hiring Requests"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="client_id"/>
            </xpath>
        </field>
    </record>

    <!-- Task search view filter -->
    <record id="view_task_search_inherit_manpower" model="ir.ui.view">
        <field name="name">project.task.search.inherit.manpower</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_tasks']" position="before">
                <filter name="filter_assigned_tasks" string="Assigned to Me" domain="[('user_ids', 'in', [uid])]"/>
                <filter name="filter_hiring_required" string="Hiring Required" domain="[('hiring_required', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Project search view filter: Assigned Projects -->
    <record id="view_project_project_filter_inherit_manpower" model="ir.ui.view">
        <field name="name">project.project.select.inherit.manpower</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='own_projects']" position="after">
                <filter name="filter_assigned_to_me" string="Assigned to Me (Project or Tasks)"
                        domain="['|', ('user_id', '=', uid), ('task_user_ids', 'in', [uid])]"/>
                <filter name="filter_hiring_required" string="Hiring Projects"
                        domain="[('hiring_required', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Project Form: Manually enable Hiring Required & Smart Button for Requests -->
    <record id="view_project_project_form_inherit_manpower" model="ir.ui.view">
        <field name="name">project.project.form.inherit.manpower</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_hiring_requests" type="object" class="oe_stat_button"
                        icon="fa-users" invisible="not hiring_required and requirement_count == 0">
                    <field name="requirement_count" widget="statinfo" string="Hiring Requests"/>
                </button>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group name="manpower_settings">
                    <field name="hiring_required" widget="boolean_toggle" string="Hiring Required"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Project Kanban View: ONLY Hiring Required Toggle on Project Card -->
    <record id="view_project_kanban_inherit_manpower" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.manpower</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="hiring_required"/>
            </xpath>
            <xpath expr="//t[@t-name='card']" position="inside">
                <field name="hiring_required" invisible="1"/>
                <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                    <span class="small text-muted fw-semibold">Hiring Required</span>
                    <button name="action_toggle_hiring_required" type="object"
                            class="btn btn-sm p-0 border-0"
                            title="Toggle Hiring Required">
                        <i t-if="record.hiring_required and record.hiring_required.raw_value"
                           class="fa fa-toggle-on fa-2x text-primary"/>
                        <i t-else=""
                           class="fa fa-toggle-off fa-2x text-muted"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
