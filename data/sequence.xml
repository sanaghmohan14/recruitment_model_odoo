<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="seq_manpower_requirement" model="ir.sequence">
            <field name="name">Manpower Requirement</field>
            <field name="code">manpower.requirement</field>
            <field name="prefix">MR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_manpower_job_opening" model="ir.sequence">
            <field name="name">Job Opening</field>
            <field name="code">manpower.job.opening</field>
            <field name="prefix">JO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_manpower_application" model="ir.sequence">
            <field name="name">Manpower Application</field>
            <field name="code">manpower.application</field>
            <field name="prefix">APP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
